<mujoco model="so100_pick_place">
  <include file="so_arm100.xml"/>

  <statistic center="0.2 0 0.1" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tabletop" rgba="0.92 0.92 0.93 1"/>
    <material name="shaker_body" rgba="0.08 0.08 0.08 1"/>
    <material name="shaker_cap" rgba="0.95 0.95 0.95 1"/>
    <material name="target" rgba="0.1 0.7 0.2 0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Floor sits one table-height (0.4m) below the tabletop, which is at z=0 where the arm is mounted. -->
    <geom name="floor" pos="0 0 -0.4" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Tabletop surface sits at z=0 so the arm (mounted at world origin) stands on it.
         Measured real desk: 40cm x 50cm white table (IMG_0351/IMG_3494). Table is positioned
         so the arm (at x=0,y=0) sits ~5cm inside the near edge, matching where the arm would
         be mounted relative to the real desk. Thickness (4cm) is an unmeasured placeholder. -->
    <geom name="table_top" type="box" pos="0.15 0 -0.02" size="0.20 0.25 0.02" material="tabletop"/>
    <geom name="table_leg" type="box" pos="0.15 0 -0.21" size="0.05 0.05 0.19" material="tabletop"/>

    <!-- Env (external) camera: fixed, wide view of the whole workspace. -->
    <camera name="env_cam" pos="0.75 -0.6 0.55" xyaxes="0.6 0.8 0 -0.35 0.26 0.9"/>

    <!-- Graspable object: real black pepper shaker (McCormick tin) from IMG_0351/IMG_3494.
         User-measured dims: 3in tall x 1.5in diameter (0.0762m x 0.0381m), black body with a
         white perforated cap (~20% of height). Mass (35g) is an unweighed placeholder -- update
         once you weigh the real one. Modeled as two stacked cylinders, same radius. -->
    <body name="shaker" pos="0.22 -0.15 0.0381">
      <freejoint name="shaker_free"/>
      <inertial pos="0 0 0" mass="0.035" diaginertia="2.011e-5 2.011e-5 6.351e-6"/>
      <geom name="shaker_body" type="cylinder" size="0.01905 0.0305" pos="0 0 -0.0076" material="shaker_body"
        friction="1 0.005 0.0001" condim="4" solimp="2 1 0.01" solref="0.01 1"/>
      <geom name="shaker_cap" type="cylinder" size="0.01905 0.0076" pos="0 0 0.0305" material="shaker_cap"
        friction="1 0.005 0.0001" condim="4" solimp="2 1 0.01" solref="0.01 1"/>
    </body>

    <!-- Target placement zone (visual only, no collision). -->
    <geom name="target_zone" type="cylinder" pos="0.22 0.18 0.0005" size="0.045 0.0005"
      material="target" contype="0" conaffinity="0"/>
  </worldbody>

  <keyframe>
    <key name="home_with_shaker" qpos="0 -1.57 1.57 1.57 -1.57 0 0.22 -0.15 0.0381 1 0 0 0"
      ctrl="0 -1.57 1.57 1.57 -1.57 0"/>
  </keyframe>
</mujoco>
